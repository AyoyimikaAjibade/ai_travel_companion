              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_price\": 2200.00,\n  \"hotel_data\": {\n    \"name\": \"Luxury Hotel\",\n    \"rating\": 5,\n    \"total_price\": 1500.00\n  },\n  \"manual\": true\n}"
            },
            "url": {
              "raw": "{{full_url}}/ai/chat/{{chat_id}}/drafts/{{slot_id}}",
              "host": ["{{full_url}}"],
              "path": ["ai", "chat", "{{chat_id}}", "drafts", "{{slot_id}}"]
            }
          }
        },
        {
          "name": "Confirm Chat and Plans",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Confirmation successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const responseData = pm.response.json();",
                  "    console.log('Confirmed plans count:', responseData.confirmed_plans_count);",
                  "    console.log('Confirmed messages count:', responseData.confirmed_messages_count);",
                  "    if (responseData.plans && responseData.plans.length > 0) {",
                  "        pm.environment.set('plan_id', responseData.plans[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"slot_ids\": [\"{{slot_id}}\"]\n}"
            },
            "url": {
              "raw": "{{full_url}}/ai/chat/{{chat_id}}/confirm",
              "host": ["{{full_url}}"],
              "path": ["ai", "chat", "{{chat_id}}", "confirm"]
            }
          }
        }
