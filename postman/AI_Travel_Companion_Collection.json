                  "    }",
                  "    console.log('Chat ID:', responseData.chat_id, 'Slot ID:', responseData.slot_id);",
                  "    console.log('Missing fields:', responseData.missing);",
                  "    console.log('Ready for search:', responseData.ready_for_search);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"I want to fly from San Francisco to Paris from November 10 to November 20 for 2 adults\",\n  \"current_slots\": null,\n  \"chat_id\": null,\n  \"slot_id\": null\n}"
            },
            "url": {
              "raw": "{{full_url}}/ai/chat/parse",
              "host": ["{{full_url}}"],
              "path": ["ai", "chat", "parse"]
            }
          }
        },
        {
          "name": "Continue Chat (Update Slots)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"My budget is $5000\",\n  \"current_slots\": {\n    \"slot_id\": \"{{slot_id}}\",\n    \"origin_airport_code\": \"SFO\",\n    \"destination_airport_code\": \"CDG\",\n    \"destination_city_code\": \"PAR\",\n    \"dates\": {\n      \"start\": \"2024-11-10\",\n      \"end\": \"2024-11-20\"\n    },\n    \"pax\": {\n      \"adults\": 2,\n      \"kids\": 0\n    }\n  },\n  \"chat_id\": \"{{chat_id}}\",\n  \"slot_id\": \"{{slot_id}}\"\n}"
            },
            "url": {
              "raw": "{{full_url}}/ai/chat/parse",
              "host": ["{{full_url}}"],
              "path": ["ai", "chat", "parse"]
            }
          }
        },
        {
          "name": "Search Travel Options",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Search successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    const responseData = pm.response.json();",
                  "    console.log('Plan generated and saved to cache');",
                  "    console.log('Plan data:', JSON.stringify(responseData.plan, null, 2));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chat_id\": \"{{chat_id}}\",\n  \"slot_id\": \"{{slot_id}}\"\n}"
            },
            "url": {
              "raw": "{{full_url}}/ai/chat/search",
              "host": ["{{full_url}}"],
              "path": ["ai", "chat", "search"]
            }
          }
        },
        {
          "name": "Get Draft Plans",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{full_url}}/ai/chat/{{chat_id}}/drafts?slot_id={{slot_id}}",
              "host": ["{{full_url}}"],
              "path": ["ai", "chat", "{{chat_id}}", "drafts"],
              "query": [
                {
                  "key": "slot_id",
                  "value": "{{slot_id}}"
                }
              ]
            }
          }
        },
        {
          "name": "Update Draft Plan",
